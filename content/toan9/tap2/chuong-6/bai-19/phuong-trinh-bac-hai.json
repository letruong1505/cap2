  "theory": [
    {
      "type": "text",
      "content": "Phương trình bậc hai một ẩn có dạng ax² + bx + c = 0 (a ≠ 0)."
    },
    {
      "type": "formula",
      "content": "Δ = b² − 4ac;  Δ > 0: x₁,₂ = (−b ± √Δ)/(2a);  Δ = 0: x₁ = x₂ = −b/(2a);  Δ < 0: vô nghiệm"
    },
    {
      "type": "text",
      "content": "Công thức nghiệm thu gọn khi b = 2b′: Δ′ = b′² − ac; Δ′ > 0: x₁,₂ = (−b′ ± √Δ′)/a."
    },
    {
      "type": "text",
      "content": "Trường hợp đặc biệt: c = 0 thì đưa về x(ax + b) = 0; b = 0 thì x² = −c/a."
    }
  ],
