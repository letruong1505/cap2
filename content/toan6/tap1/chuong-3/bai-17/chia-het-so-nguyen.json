  "requirements": [
    "Thực hiện phép chia hết hai số nguyên; tìm ước và bội của một số nguyên."
  ],
  "theory": [
    {
      "type": "text",
      "content": "Cho a, b ∈ ℤ, b ≠ 0. Nếu có q ∈ ℤ sao cho a = b·q thì a chia hết cho b; q là thương. Chia hai số nguyên khác dấu: thương mang dấu \"−\"; cùng dấu: thương mang dấu \"+\"."
    },
    {
      "type": "text",
      "content": "Nếu a ⋮ b thì a là bội của b, b là ước của a. Nếu a là bội của b thì −a cũng là bội của b; nếu b là ước của a thì −b cũng là ước của a."
    },
    {
      "type": "text",
      "content": "Ví dụ: các ước của 6 là ±1; ±2; ±3; ±6 (tám ước)."
    }
  ],
  "examples": [
    {
      "problem": "Tính (−84) : 7.",
      "steps": [
        "Khác dấu nên thương âm.",
        "84 : 7 = 12 ⇒ −12."
      ],
      "expr": "(-84)/7",
      "answer": "-12"
    },
    {
      "problem": "Dạng đếm ước nguyên: số 12 có bao nhiêu ước nguyên?",
      "steps": [
        "12 có 6 ước tự nhiên 1, 2, 3, 4, 6, 12.",
        "Mỗi ước có thêm số đối: 6·2 = 12 ước nguyên."
      ],
      "expr": "6*2",
      "answer": "12"
    }
  ],
