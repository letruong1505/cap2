  "requirements": [
    "Vận dụng quy tắc bỏ dấu ngoặc để tính hợp lí."
  ],
  "theory": [
    {
      "type": "text",
      "content": "Khi bỏ dấu ngoặc có dấu \"+\" đứng trước, giữ nguyên dấu các số hạng trong ngoặc: a + (b − c) = a + b − c."
    },
    {
      "type": "text",
      "content": "Khi bỏ dấu ngoặc có dấu \"−\" đứng trước, phải đổi dấu tất cả các số hạng trong ngoặc: dấu \"+\" thành \"−\", dấu \"−\" thành \"+\": a − (b − c) = a − b + c."
    },
    {
      "type": "text",
      "content": "Trong một tổng đại số, có thể đổi chỗ các số hạng kèm theo dấu của chúng và nhóm các số hạng tuỳ ý."
    }
  ],
  "examples": [
    {
      "problem": "Tính (56 − 27) − (11 − 27).",
      "steps": [
        "Bỏ ngoặc: 56 − 27 − 11 + 27.",
        "= 56 − 11 = 45."
      ],
      "expr": "56-27-11+27",
      "answer": "45"
    },
    {
      "problem": "Dạng tính nhanh: 768 − 39 − (68 − 39).",
      "steps": [
        "Bỏ ngoặc: 768 − 39 − 68 + 39.",
        "= 768 − 68 = 700."
      ],
      "expr": "768-68",
      "answer": "700"
    }
  ],
