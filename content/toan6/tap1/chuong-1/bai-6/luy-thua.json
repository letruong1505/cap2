  "theory": [
    {
      "type": "text",
      "content": "Luỹ thừa bậc n của a là tích của n thừa số bằng nhau, mỗi thừa số bằng a (n ∈ ℕ*). a là cơ số, n là số mũ. a² đọc là a bình phương, a³ đọc là a lập phương. Quy ước a¹ = a, a⁰ = 1 (a ≠ 0)."
    },
    {
      "type": "figure",
      "figure": "figures/t6-b6-luy-thua.svg",
      "caption": "Bình phương và lập phương (sơ đồ)"
    },
    {
      "type": "formula",
      "content": "aⁿ = a·a·…·a (n thừa số a)"
    },
    {
      "type": "formula",
      "content": "aᵐ·aⁿ = aᵐ⁺ⁿ;   aᵐ : aⁿ = aᵐ⁻ⁿ (a ≠ 0, m ≥ n)"
    },
    {
      "type": "text",
      "content": "Mọi số tự nhiên đều viết được dưới dạng tổng giá trị các chữ số nhân với luỹ thừa của 10, ví dụ 2 345 = 2·10³ + 3·10² + 4·10 + 5."
    }
  ],
  "examples": [
