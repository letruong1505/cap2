  "theory": [
    {
      "type": "text",
      "content": "Phép nhân: a × b = c (a, b là thừa số, c là tích). Tính chất: giao hoán a·b = b·a; kết hợp (a·b)·c = a·(b·c); nhân với 1: a·1 = a; phân phối đối với phép cộng và phép trừ."
    },
    {
      "type": "formula",
      "content": "a·(b + c) = a·b + a·c;   a·(b − c) = a·b − a·c"
    },
    {
      "type": "text",
      "content": "Phép chia hết: a = b·q (b ≠ 0), q là thương. Phép chia có dư: a = b·q + r với 0 < r < b; r là số dư, luôn nhỏ hơn số chia."
    }
  ],
  "examples": [
    {
