      "problem": "Phân tích 120 ra thừa số nguyên tố và kiểm tra.",
      "steps": [
        "120 = 2³·3·5.",
        "Kiểm tra: 8·3·5 = 120."
      ],
      "expr": "8*3*5",
      "answer": "120"
    },
    {
      "problem": "Dạng đếm ước từ dạng phân tích: 72 = 2³·3² có bao nhiêu ước?",
      "steps": [
        "Số ước = (3 + 1)·(2 + 1).",
        "= 12 ước."
      ],
      "expr": "(3+1)*(2+1)",
      "answer": "12"
    }
  ],
