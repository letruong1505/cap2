  "theory": [
    {
      "type": "formula",
      "content": "A³ + B³ = (A + B)(A² − AB + B²)   (tổng hai lập phương)"
    },
    {
      "type": "formula",
      "content": "A³ − B³ = (A − B)(A² + AB + B²)   (hiệu hai lập phương)"
    },
    {
      "type": "text",
      "content": "Chú ý: A² − AB + B² gọi là bình phương thiếu của hiệu A − B, còn A² + AB + B² gọi là bình phương thiếu của tổng A + B. Hãy nhớ dấu: tổng hai lập phương có thừa số thứ nhất là A + B; hiệu hai lập phương có thừa số thứ nhất là A − B."
    }
  ],
  "examples": [
    {
      "problem": "Tính 1³ + 9³ bằng hằng đẳng thức tổng hai lập phương.",
      "steps": [
        "1³ + 9³ = (1 + 9)(1² − 1·9 + 9²) = 10·(1 − 9 + 81) = 10·73 = 730."
      ],
      "expr": "10*(1-9+81)",
      "answer": "730"
    },
    {
      "problem": "Tính 5³ − 3³.",
      "steps": [
        "5³ − 3³ = (5 − 3)(5² + 5·3 + 3²) = 2·(25 + 15 + 9) = 2·49 = 98."
      ],
      "expr": "2*(25+15+9)",
      "answer": "98"
    }
  ],
