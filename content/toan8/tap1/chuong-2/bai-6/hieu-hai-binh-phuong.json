      "problem": "Tính nhanh 51².",
      "steps": [
        "Viết 51 = 50 + 1.",
        "51² = (50 + 1)² = 50² + 2·50·1 + 1² = 2 500 + 100 + 1 = 2 601."
      ],
      "expr": "50*50+2*50+1",
      "answer": "2601"
