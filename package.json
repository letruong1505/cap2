{
  "name": "vung-bai",
  "productName": "Giáo trình THCS",
  "version": "0.1.0-dev",
  "description": "Phần mềm luyện tập offline cấp 2 (Toán 7 - KNTT, bản thử)",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "validate": "node tools/validate-content.js",
    "test": "node --test tests/license.test.js",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:keygen": "electron-builder --win portable --config keygen/builder.json"
  },
  "build": {
    "appId": "vn.namlinh.vungbai",
    "productName": "Giáo trình THCS",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "core/**/*",
      "content/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "GiaoTrinhTHCS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Giáo trình THCS",
      "uninstallDisplayName": "Giáo trình THCS",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  }
}
